{
  "server": {
    "host": "${VDASH_HOST:-127.0.0.1}",
    "port": "${VDASH_PORT:-${PORT:-8050}}"
  },
  "session": {
    "secret": "${VDASH_SESSION_SECRET:-}",
    "ttl_minutes": 43200,
    "cookie_secure": "${VDASH_COOKIE_SECURE:-false}",
    "login_max_failures": 5,
    "login_lockout_minutes": 5
  },
  "refresh": {
    "enabled": true,
    "interval_minutes": 15,
    "prewarm_presets": [
      "last_30_days",
      "last_7_days",
      "last_90_days",
      "mtd",
      "qtd",
      "ytd",
      "last_12_months",
      "prev_month"
    ],
    "prewarm_sections": "all"
  },
  "cache": {
    "_comment": "v20: ttl_minutes 0 = no expiry (results are keyed by the data version, a new load replaces them). persist_path keeps results in a file so a restart starts warm; empty = memory only.",
    "max_entries": 5000,
    "ttl_minutes": 0,
    "persist_path": "runtime/result_cache.db"
  },
  "query": {
    "timeout_seconds": 30,
    "parallel": 4,
    "log_slow_seconds": 1.0
  },
  "state_store": {
    "path": "runtime/dashboard_state.db"
  }
}
