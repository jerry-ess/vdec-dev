# Veridex BI dashboard - settings for THIS machine (v19).
# Copy to config/local.env and edit. local.env is never committed (.gitignore) and never synced to the deploy repo.
# Lines are KEY=VALUE. A variable that is already set in the real environment wins over this file.
# Online (Render) the same variables are set in the service's Environment settings instead.

# Profile: local or online (online adds config/*.online.json). Default: online on Render, local elsewhere.
VDASH_ENV=local

# Warehouse the demo tenants read. Relative paths are relative to the dashboard folder.
VDASH_DEMO_DB=D:/work/my_ai_projects/generative_bi/latest_system/ui_orchestrator/output/dw_tmpl-retail-trade-004_20260923_1220.db

# Optional
# VDASH_HOST=127.0.0.1
# VDASH_PORT=8050
# VDASH_SESSION_SECRET=      (empty locally: a key is kept in runtime/session_secret.key)

# v25: report store (saved report settings, schedules, history). Empty = local SQLite file runtime/reports.db.
# PostgreSQL (e.g. Aiven): the service URI and the project CA certificate (file path, relative to the dashboard folder).
# VDASH_REPORT_DB_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# VDASH_REPORT_DB_CA=ca.pem
# Online (Render): VDASH_REPORT_DB_URL as above and VDASH_REPORT_DB_CA_PEM = the full text of ca.pem.

# v37: AI report writer. The API key of the chosen provider (default DeepSeek). Online (Render): set the same variable
# in the service's Environment settings. Optional: VDASH_LLM_PROVIDER=gemini|openai|anthropic, VDASH_LLM_MODEL=...,
# VDASH_LLM_ENABLED=false to switch AI writing off.
# DEEPSEEK_API_KEY=sk-...
