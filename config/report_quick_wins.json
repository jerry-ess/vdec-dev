{
  "_about": "v28: Quick wins = concrete actions in a report, matched from early warnings, the business evaluation and KPI results. Each action names the finding it comes from ('because'), so nothing is invented. Text templates: i18n ui keys rpt_qw_*. Validate with: python tools/check_report_blocks.py",
  "version": 1,
  "max_actions": 6,

  "_sources": "warning: an early warning of this rule is active | evaluation: a finding of this rule (and side) in the report period | kpi: the first / best row of a KPI table meeting typed conditions",
  "_args": "template argument -> finding argument (warning / evaluation) or table column (kpi); number formats come from the source",
  "_because": "warning / evaluation: the finding's own sentence. kpi: optional {template, args} built from the chosen row, else 'From: <KPI>'",
  "_conditions": "typed: {\"field\": <column>, \"op\": one of >= > <= < == !=, \"value\": number}; 'where' filters rows, 'when' must hold for the chosen row",

  "triggers": [
    {"id": "qw_stale_data", "source": "warning", "rule": "stale_data", "template": "rpt_qw_stale_data",
     "args": {"n": "n"}, "priority": "high", "timeline_days": 1},
    {"id": "qw_churn", "source": "warning", "rule": "high_value_churn", "template": "rpt_qw_churn",
     "args": {"n": "n", "amount": "amount"}, "priority": "high", "timeline_days": 7},
    {"id": "qw_overdue", "source": "warning", "rule": "overdue_regulars", "template": "rpt_qw_overdue",
     "args": {"n": "n", "amount": "amount"}, "priority": "high", "timeline_days": 7},
    {"id": "qw_recent_drop", "source": "warning", "rule": "recent_drop", "template": "rpt_qw_recent_drop",
     "args": {"delta": "delta"}, "priority": "high", "timeline_days": 7},
    {"id": "qw_forecast_drop", "source": "warning", "rule": "forecast_drop", "template": "rpt_qw_forecast_drop",
     "args": {"delta": "delta"}, "priority": "medium", "timeline_days": 7},
    {"id": "qw_mtd_pace", "source": "warning", "rule": "mtd_pace", "template": "rpt_qw_mtd_pace",
     "args": {"month": "month", "delta": "delta"}, "priority": "medium", "timeline_days": 7},
    {"id": "qw_bestseller", "source": "warning", "rule": "bestseller_decline", "template": "rpt_qw_bestseller",
     "args": {"n": "n", "share": "share"}, "priority": "medium", "timeline_days": 30},
    {"id": "qw_new_customers", "source": "warning", "rule": "new_customers_drop", "template": "rpt_qw_new_customers",
     "args": {"delta": "delta"}, "priority": "medium", "timeline_days": 30},
    {"id": "qw_bundle", "source": "kpi", "kpi": "affinity_pairs", "pick": {"max": "together"},
     "_pick": "the pair bought together most often among the strong pairs (a very high ratio on a rare pair is not worth a combo)",
     "where": [{"field": "together", "op": ">=", "value": 3}, {"field": "lift_v", "op": ">=", "value": 2.0}],
     "template": "rpt_qw_bundle", "args": {"product_a": "item_a", "product_b": "item_b", "lift": "lift_v"},
     "because": {"template": "rpt_qw_because_pair", "args": {"together": "together", "conf": "conf", "product_a": "item_a", "product_b": "item_b"}},
     "priority": "medium", "timeline_days": 7},
    {"id": "qw_products_losing", "source": "evaluation", "rule": "product_movers", "side": "negative",
     "template": "rpt_qw_products_losing", "args": {"names": "names", "amount": "amount"},
     "priority": "medium", "timeline_days": 30},
    {"id": "qw_concentration", "source": "evaluation", "rule": "customer_concentration", "side": "negative",
     "template": "rpt_qw_concentration", "args": {"n": "n", "share": "share"}, "priority": "medium", "timeline_days": 30},
    {"id": "qw_repeat_rate", "source": "evaluation", "rule": "chg_repeat_rate", "side": "negative",
     "template": "rpt_qw_repeat_rate", "args": {"value": "value"}, "priority": "medium", "timeline_days": 30},
    {"id": "qw_aov", "source": "evaluation", "rule": "chg_aov", "side": "negative",
     "template": "rpt_qw_aov", "args": {"value": "value"}, "priority": "medium", "timeline_days": 30},
    {"id": "qw_new_customers_period", "source": "evaluation", "rule": "chg_new_customers", "side": "negative",
     "template": "rpt_qw_new_customers_period", "args": {"delta": "delta"}, "priority": "medium", "timeline_days": 30,
     "unless": ["qw_new_customers"]}
  ]
}
