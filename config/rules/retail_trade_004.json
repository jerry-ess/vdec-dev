{
  "_about": [
    "Business evaluation (Executive Overview) and early-warning (AI Insights) rules for the retail_trade_004 catalog.",
    "Edit this file to change thresholds, weights, which rules run, or to add a rule. No code change or restart is needed:",
    "the dashboard picks the change up within a minute. Check your edit first:  python tools/check_rules.py",
    "List the check types, their parameters and allowed ranges:  python tools/check_rules.py --describe",
    "An invalid file is rejected and the last valid rules stay in use (the error is shown to platform admins).",
    "Per-business changes go in config/tenants.json -> alerts: {disabled: [...], enabled: [...], params: {rule id: {...}}}."
  ],
  "_fields": {
    "id": "unique rule id (letters, digits, _)",
    "enabled": "true/false: switch the rule on or off for every business",
    "panel": "evaluation (Overview, selected period) or warning (AI Insights, latest data)",
    "check": "check type, see --describe",
    "kpi": "kpi_change only: the dashboard KPI to watch",
    "data": "other checks: the data set the check reads (see --describe)",
    "title": "optional for kpi_change (defaults to the KPI title); text, or {\"en\": ..., \"vi\": ...} per language",
    "weight": "ranking weight inside its column (higher = listed earlier)",
    "link": "KPI opened by 'See chart'",
    "show_names_to": "role that sees customer names in the finding's list (can be raised, not lowered below the data set's floor)",
    "visible_to": "minimum role that sees the finding (viewer, manager, tenant_admin)",
    "params": "thresholds, see --describe"
  },
